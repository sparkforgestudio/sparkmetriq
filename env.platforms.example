# ===========================================
# CONFIGURATION DES PLATEFORMES - MUSE MGM PLATFORM
# ===========================================
# Copiez ce fichier vers .env et configurez vos credentials

# ===========================================
# TIKTOK CONFIGURATION
# ===========================================
# Obtenez ces credentials depuis https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_REDIRECT_URI=https://your-domain.com/auth/tiktok/callback

# Webhook TikTok (optionnel)
TIKTOK_WEBHOOK_SECRET=your_tiktok_webhook_secret_here
TIKTOK_VERIFY_TOKEN=your_tiktok_verify_token_here

# ===========================================
# FANVUE CONFIGURATION
# ===========================================
# Obtenez ces credentials depuis votre dashboard Fanvue
FANVUE_API_KEY=your_fanvue_api_key_here
FANVUE_API_SECRET=your_fanvue_api_secret_here

# Webhook Fanvue (optionnel)
FANVUE_WEBHOOK_SECRET=your_fanvue_webhook_secret_here
FANVUE_VERIFY_TOKEN=your_fanvue_verify_token_here

# ===========================================
# ONLYFANS CONFIGURATION
# ===========================================
# Obtenez ces credentials depuis votre dashboard OnlyFans
ONLYFANS_API_KEY=your_onlyfans_api_key_here
ONLYFANS_API_SECRET=your_onlyfans_api_secret_here

# Webhook OnlyFans (optionnel)
ONLYFANS_WEBHOOK_SECRET=your_onlyfans_webhook_secret_here
ONLYFANS_VERIFY_TOKEN=your_onlyfans_verify_token_here

# ===========================================
# MYM.FANS CONFIGURATION
# ===========================================
# Obtenez ces credentials depuis votre dashboard MYM.fans
MYMFANS_API_KEY=your_mymfans_api_key_here
MYMFANS_API_SECRET=your_mymfans_api_secret_here

# Webhook MYM.fans (optionnel)
MYMFANS_WEBHOOK_SECRET=your_mymfans_webhook_secret_here
MYMFANS_VERIFY_TOKEN=your_mymfans_verify_token_here

# ===========================================
# MANYVIDS CONFIGURATION
# ===========================================
# Obtenez ces credentials depuis votre dashboard ManyVids
MANYVIDS_API_KEY=your_manyvids_api_key_here
MANYVIDS_API_SECRET=your_manyvids_api_secret_here

# Webhook ManyVids (optionnel)
MANYVIDS_WEBHOOK_SECRET=your_manyvids_webhook_secret_here
MANYVIDS_VERIFY_TOKEN=your_manyvids_verify_token_here

# ===========================================
# PLATEFORMES EXISTANTES (AMÉLIORÉES)
# ===========================================

# Instagram
INSTAGRAM_GRAPH_TOKEN=your_instagram_graph_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
INSTAGRAM_WEBHOOK_SECRET=your_instagram_webhook_secret_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Threads
META_ACCESS_TOKEN=your_meta_access_token_here
THREADS_USER_ID=your_threads_user_id_here
THREADS_WEBHOOK_SECRET=your_threads_webhook_secret_here

# Snapchat
SNAPCHAT_CLIENT_ID=your_snapchat_client_id_here
SNAPCHAT_CLIENT_SECRET=your_snapchat_client_secret_here
SNAPCHAT_WEBHOOK_SECRET=your_snapchat_webhook_secret_here

# Reddit
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here
REDDIT_WEBHOOK_SECRET=your_reddit_webhook_secret_here

# Twitter
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here
TWITTER_WEBHOOK_SECRET=your_twitter_webhook_secret_here

# Facebook
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token_here
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_WEBHOOK_SECRET=your_facebook_webhook_secret_here

# WhatsApp
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_WEBHOOK_SECRET=your_whatsapp_webhook_secret_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token_here

# ===========================================
# CONFIGURATION GÉNÉRALE
# ===========================================

# Base URL de votre API (pour les webhooks)
API_BASE_URL=https://your-domain.com

# Base de données MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=musemgmtdb

# JWT Secret
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256

# Mode de test
TESTING=false

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_FILE=logs/platform.log

# Telegram Logger (optionnel)
TELEGRAM_LOGGER_BOT_TOKEN=your_telegram_logger_bot_token_here
TELEGRAM_LOGGER_CHAT_ID=your_telegram_logger_chat_id_here

# ===========================================
# PAIEMENTS
# ===========================================
# NOWPayments
NOWPAYMENTS_API_KEY=your_nowpayments_api_key_here
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io
NOWPAYMENTS_URL=https://nowpayments.io

# ===========================================
# NOTES IMPORTANTES
# ===========================================
# 1. Remplacez toutes les valeurs "your_*_here" par vos vrais credentials
# 2. Gardez ce fichier sécurisé et ne le commitez jamais
# 3. Utilisez des secrets forts pour les webhooks
# 4. Testez d'abord en mode TESTING=true
# 5. Consultez PLATFORMS_INTEGRATION.md pour plus de détails
