# ===== App =====
APP_NAME=APP_NAME=SparkMetrIQ
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

META_ACCESS_TOKEN=votre_meta_access_token_ici
THREADS_USER_ID=votre_threads_user_id_ici
NOWPAYMENTS_API_KEY=« votre_api_key »
TEST_DB_URI=mongodb://localhost:27017/musemgmt_test
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ===== Mongo Core / BI =====
MONGO_URI=mongodb://localhost:27017
DB_NAME_CORE=musai_core

MONGO_URI_BI=mongodb://localhost:27017
DB_NAME_BI=musai_bi

# ===== Feature Flags =====
ENABLE_BI=true
ENABLE_SCHEDULER=true
FEATURE_CLOUDPHONE_ENABLED=false
FEATURE_OTP_ENABLED=false
FEATURE_TRANSLATOR_ENABLED=true
FEATURE_CONVO_RECAP_ENABLED=true
FEATURE_MESSAGE_BUILDER_ENABLED=true
FEATURE_LINK_TRACKING_ENABLED=true
FEATURE_COLLAB_ENABLED=true

# ===== Translator / Recap (optionnel: LLM proxy) =====
TRANSLATOR_LLM_BASE_URL=
TRANSLATOR_LLM_MODEL=deepseek-chat
LANG_DETECT_BACKEND=langdetect
RECAP_LLM_BASE_URL=
RECAP_LLM_MODEL=deepseek-chat

# ===== Link Tracking =====
TRACKING_DOMAIN_BASE=http://localhost:8000
ATTRIBUTION_MODEL=last_touch
CLICK_IP_HASH_SALT=dev-salt
TRACK_MAX_REDIRECTS_PER_MIN=2000
TRACK_CODE_LENGTH=8

# ===== Security =====
SECURITY_SECRET_KEY=dev-secret-not-for-prod
SECURITY_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_EXPIRE_MINUTES=60
SECURITY_REFRESH_TOKEN_EXPIRE_DAYS=7
SECURITY_ENCRYPT_PII=true
SECURITY_PII_RETENTION_DAYS=90
SECURITY_ANONYMIZE_LOGS=true

# ===== Observability =====
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_LOG_FORMAT=json
OBSERVABILITY_ENABLE_PROMETHEUS=false
OBSERVABILITY_PROMETHEUS_PORT=9000
OBSERVABILITY_ENABLE_WEBSOCKETS=true
OBSERVABILITY_ENABLE_TELEGRAM=false

# ===== Testing =====
TESTING=false
TEST_DB_URI=mongodb://localhost:27017/musemgmt_test

# ===== Connecteurs / Paiements / OAuth =====
META_ACCESS_TOKEN=votre_meta_access_token_ici
THREADS_USER_ID=votre_threads_user_id_ici
NOWPAYMENTS_API_KEY=votre_api_key
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
