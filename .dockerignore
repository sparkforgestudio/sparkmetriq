# .dockerignore
# Fichiers et dossiers à exclure du contexte Docker

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
*.egg-info/
dist/
build/
*.egg

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next/
out/
dist/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
docs/
README*.md
CHANGELOG.md

# Tests
tests/
chat_tests/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# Logs
logs/
*.log

# Environment
.env
.env.local
.env.*.local
*.env

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Archives
*.zip
*.tar
*.tar.gz
*.rar

# Frontend build artifacts (sauf ceux nécessaires)
frontend/admin_panel/.next/cache/
frontend/admin_panel/.next/static/chunks/*.js.map

# MongoDB
mongo_schema.js
*.mjs

# Scripts de développement
launch_*.sh
launch_*.bat
prepare_env.*
install_*.sh
setup_project.py

# Autres
arborescence.txt
Makefile
pnpm-workspace.yaml
package-lock.json
yarn.lock
pnpm-lock.yaml
